# Copy to `.env` in the repo root (gitignored). Values here load when the server starts.
# Existing OS environment variables win; launcher merges `.env` into the dev child process too.

VVR_AI_UPSCALER_ENABLED=true
VVR_REALESRGAN_MODEL_NAME=upscayl-lite-4x

# Optional absolute paths. Omit these lines (or leave the value empty) to use standalone tools/realesrgan/
# after: npm run setup:ai-lite
# Windows:
# VVR_REALESRGAN_BINARY=C:\path\to\VVR_APP\tools\realesrgan\win-x64\realesrgan-ncnn-vulkan.exe
# Linux:
# VVR_REALESRGAN_BINARY=/path/to/VVR_APP/tools/realesrgan/linux-x64/realesrgan-ncnn-vulkan
# VVR_REALESRGAN_MODEL_DIR=/path/to/VVR_APP/tools/realesrgan/models

# Optional: fixes relative VVR_REALESRGAN_* paths to this folder (defaults to repo root detection)
# VVR_REALESRGAN_PROJECT_ROOT=
