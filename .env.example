# Copy to `.env` in the repo root (gitignored). Values here load when the server starts.
# Existing OS environment variables win; launcher merges `.env` into the dev child process too.

RIBO_AI_UPSCALER_ENABLED=true
RIBO_REALESRGAN_MODEL_NAME=upscayl-lite-4x

# Optional absolute paths. Omit these lines (or leave the value empty) to use standalone tools/realesrgan/
# after: npm run setup:ai-lite
# Windows:
# RIBO_REALESRGAN_BINARY=C:\path\to\ribo-studio\tools\realesrgan\win-x64\realesrgan-ncnn-vulkan.exe
# Linux:
# RIBO_REALESRGAN_BINARY=/path/to/ribo-studio/tools/realesrgan/linux-x64/realesrgan-ncnn-vulkan
# RIBO_REALESRGAN_MODEL_DIR=/path/to/ribo-studio/tools/realesrgan/models

# Optional: fixes relative RIBO_REALESRGAN_* paths to this folder (defaults to repo root detection)
# RIBO_REALESRGAN_PROJECT_ROOT=
