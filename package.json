{
  "name": "vvr-app",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "description": "Ribo Studio — Shorts, Screensaver, Thumbnail Studio, Image Upscaler, and Audio Looper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibrahimbilal/ribo-studio.git"
  },
  "homepage": "https://github.com/ibrahimbilal/ribo-studio#readme",
  "bugs": {
    "url": "https://github.com/ibrahimbilal/ribo-studio/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green npm:dev:server npm:dev:client",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build:dev": "npm run build:dev -w client",
    "build:prod": "npm run build:prod -w client && npm run build:prod -w server",
    "start:dev": "npm run build:dev && npm run start:dev -w server",
    "start:prod": "npm run build:prod && npm run start:prod -w server",
    "build": "npm run build:dev -w client",
    "start": "npm run build:dev && npm run start:dev -w server",
    "typecheck": "npm run typecheck -w client && npm run typecheck -w server",
    "test:screensaver": "npm run test:screensaver -w server",
    "test:screensaver-subscribe": "npm run test:screensaver-subscribe -w server",
    "test:screensaver-cfr": "npm run test:screensaver-cfr -w server",
    "test:screensaver-visual": "npm run test:screensaver-visual -w server",
    "bench:screensaver-compose": "npm run bench:screensaver-compose -w server",
    "bench:screensaver": "npm run bench:screensaver -w server",
    "bench:screensaver-subscribe": "npm run bench:screensaver-subscribe -w server",
    "bench:screensaver-cfr": "npm run bench:screensaver-cfr -w server",
    "poc:optimized-cfr": "npm run poc:optimized-cfr -w server",
    "export:screensaver-cfr-youtube": "npm run export:screensaver-cfr-youtube -w server",
    "bench:ranking": "npm run bench:ranking -w server",
    "bench:render-report": "npm run bench:render-report -w server",
    "test:ranking": "npm run test:ranking -w server",
    "test:image-motion": "npm exec -w server -- tsx --test ../shared/imageMotion.test.ts && npm exec -w server -- tsx scripts/verify-image-motion.ts",
    "test:thumbnail": "npm exec -w server -- tsx --test ../shared/thumbnail.test.ts",
    "test:upscaler": "npm exec -w server -- tsx --test ../shared/imageUpscaler.test.ts src/imageUpscaler.test.ts src/realesrgan.test.ts src/realesrganStandalone.test.ts && node --test scripts/ai-lite-env.test.cjs",
    "test:audio-looper": "npm run test:audio-looper -w server",
    "launch": "node scripts/launch-dev.cjs",
    "launch:linux": "bash scripts/launch-linux.sh",
    "build:launcher": "node scripts/build-launcher.mjs",
    "pack:hostinger": "node scripts/make-deploy-archive.mjs",
    "setup:ai-lite": "node scripts/setup-ai-lite.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:patch": "node scripts/release.mjs prepare patch",
    "release:minor": "node scripts/release.mjs prepare minor",
    "release:major": "node scripts/release.mjs prepare major",
    "release:dry-patch": "node scripts/release.mjs prepare patch --dry-run",
    "release:dry-minor": "node scripts/release.mjs prepare minor --dry-run",
    "release:dry-major": "node scripts/release.mjs prepare major --dry-run"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "concurrently": "^10.0.6",
    "unzipper": "^0.12.3"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "multer": "2.5.0",
    "minimatch": "^11.0.1"
  }
}
